# Copy this file to .env and fill in your own values.
# Never commit the real .env file.

# Port the API listens on (the frontend expects 8000, see Web Frontend/src/Url.js)
PORT=8000

# MongoDB connection string (local MongoDB or MongoDB Atlas)
DBURL=mongodb://127.0.0.1:27017/urbanscrapman

# Secret used to sign login tokens (JWT). Use a long random string.
JWT_KEY=change_me_to_a_long_random_secret

# Fast2SMS API key for sending OTP SMS.
# Leave empty in development: the OTP will always be 123456 and no SMS is sent.
OTP_API=
